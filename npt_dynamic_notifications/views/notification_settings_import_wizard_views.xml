<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_dynamic_notification_settings_import_wizard_form" model="ir.ui.view">
        <field name="name">dynamic.notification.settings.import.wizard.form</field>
        <field name="model">dynamic.notification.settings.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Dynamic Notification Settings" create="false" edit="false">
                <group>
                    <field name="file_data" filename="file_name"/>
                    <field name="file_name" invisible="1"/>
                    <field name="replace_existing"/>
                    <field name="update_existing" invisible="replace_existing"/>
                </group>
                <group string="Result" invisible="not result_log">
                    <field name="result_log" nolabel="1" widget="text"/>
                </group>
                <footer>
                    <button name="action_import" string="Import" type="object" class="btn-primary"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dynamic_notification_settings_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Dynamic Notification Settings</field>
        <field name="res_model">dynamic.notification.settings.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
