<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_notification_config_tree" model="ir.ui.view">
        <field name="name">notification.config.tree</field>
        <field name="model">notification.config</field>
        <field name="arch" type="xml">
            <list string="Notification Rules" import="1" export_xlsx="1">
                <header>
                    <button name="action_export_settings"
                            string="Export"
                            type="object"
                            invisible="1"
                            display="always"
                            class="btn-secondary"/>
                    <button name="%(action_dynamic_notification_settings_import_wizard)d"
                            string="Import"
                            type="action"
                            invisible="1"
                            display="always"
                            class="btn-secondary"/>
                </header>
                <field name="name"/>
                <field name="active"/>
                <field name="model_id"/>
                <field name="event_type"/>
                <field name="field_name"/>
                <field name="recipient_type"/>
                <field name="record_field_name"/>
                <field name="group_ids" widget="many2many_tags" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_notification_config_form" model="ir.ui.view">
        <field name="name">notification.config.form</field>
        <field name="model">notification.config</field>
        <field name="arch" type="xml">
            <form string="Notification Rule">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="model_id" options="{'no_create': True}"/>
                        <field name="event_type"/>
                        <field name="field_name" modifiers='{"required": [["event_type", "=", "state_change"]]}'/>
                        <field name="apply_to_children"/>
                        <field name="domain"/>
                        <field name="operation_type_ids" widget="many2many_tags"
                               modifiers='{"invisible": [["model_id.model", "not in", ["stock.picking", "stock.move", "stock.move.line"]]]}'/>
                    </group>
                    <group string="Recipients">
                        <field name="recipient_type"/>
                        <field name="partner_ids" widget="many2many_tags"
                               modifiers='{"invisible": [["recipient_type", "!=", "fixed_partners"]]}'/>
                        <field name="group_ids" widget="many2many_tags"
                               modifiers='{"invisible": [["recipient_type", "!=", "group_users"]]}'/>
                        <field name="record_field_name"
                               modifiers='{"invisible": [["recipient_type", "!=", "record_field_partner"]]}'/>
                    </group>
                    <group string="Message">
                        <field name="subject_template"/>
                        <field name="message_template" nolabel="1" widget="html"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_notification_config" model="ir.actions.act_window">
        <field name="name">Dynamic Notifications</field>
        <field name="res_model">notification.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_dynamic_notifications_root"
              name="Dynamic Notifications"
              sequence="99"
              action="action_notification_config"
              groups="base.group_system"/>
</odoo>
